# Local environment for development: copy to .env and fill in the values you need.
# `pnpm dev` loads .env with `node --env-file=.env`; variables already set in your shell take
# precedence. Empty variables count as unset: the server then applies its own defaults, which the
# configuration reference lists. Never commit .env.
AMBROGIO_ENV=development

# HTTP listener
AMBROGIO_HTTP_HOST=
AMBROGIO_HTTP_PORT=
AMBROGIO_PUBLIC_HTTPS=
AMBROGIO_HSTS_MAX_AGE_SECONDS=
AMBROGIO_ALLOWED_ORIGINS=

# Conversations
AMBROGIO_ARCHIVE_PATH=
AMBROGIO_LANGUAGE=
AMBROGIO_TIME_ZONE=
AMBROGIO_LIST_PAGE_SIZE=
AMBROGIO_MAX_LIST_PAGE_SIZE=

# Agents: the directory of the agent JSON files
AMBROGIO_AGENTS_DIR=

# Voice: leave AMBROGIO_VOICE_LANGUAGES empty to disable voice
AMBROGIO_VOICE_LANGUAGES=
AMBROGIO_VOICE_EN_STT_MODEL_DIR=
AMBROGIO_VOICE_EN_ENGINE=
AMBROGIO_VOICE_EN_MODEL_DIR=
AMBROGIO_VOICE_EN_SPEAKER=
AMBROGIO_VOICE_EN_LANGUAGE=
AMBROGIO_VOICE_IT_STT_MODEL_DIR=
AMBROGIO_VOICE_IT_ENGINE=
AMBROGIO_VOICE_IT_MODEL_DIR=
AMBROGIO_VOICE_IT_SPEAKER=
AMBROGIO_VOICE_IT_LANGUAGE=

# Credentials named by the example agent files
MISTRAL_API_KEY=
HOME_ASSISTANT_LONG_LIVED_ACCESS_TOKEN=
