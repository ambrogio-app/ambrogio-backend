#!/bin/sh
# Block commits that add secrets or leave the model of the workspace invalid.
# Enable once per clone: git config core.hooksPath .githooks
required=8.30.1
if ! command -v gitleaks >/dev/null 2>&1 || [ "$(gitleaks version 2>/dev/null)" != "$required" ]; then
  echo "pre-commit: gitleaks $required is not on PATH; install gitleaks $required (https://github.com/gitleaks/gitleaks/releases/tag/v$required) and retry." >&2
  exit 1
fi
# --ignore-gitleaks-allow: an inline gitleaks:allow comment never hides a finding; exceptions live only in
# .gitleaksignore, a governed file referenced by the model.
gitleaks git --pre-commit --staged --redact --no-banner --ignore-gitleaks-allow . || exit 1
# The checks of the whole model live in ambrogio-model, next to this repository; they read the staged
# content of this repository, the content about to be committed.
top="$(git rev-parse --show-toplevel)"
checks="$top/../ambrogio-model/scripts/model-checks"
if [ ! -x "$checks" ]; then
  echo "pre-commit: ambrogio-model is not next to this repository; clone https://github.com/ambrogio-app/ambrogio-model beside it and retry." >&2
  exit 1
fi
index="${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}"
case "$index" in /*) ;; *) index="$(pwd)/$index" ;; esac
exec "$checks" --staged "$top" "$index"
