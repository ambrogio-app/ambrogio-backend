#!/bin/sh
# Block commits that add secrets or leave the model of the workspace invalid.
# Enable once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH; install gitleaks 8.30.1 (https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1) and retry." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner . || exit 1
# The checks of the whole model live in ambrogio-model, next to this repository.
checks="$(git rev-parse --show-toplevel)/../ambrogio-model/scripts/model-checks"
if [ ! -x "$checks" ]; then
  echo "pre-commit: ambrogio-model is not next to this repository; clone https://github.com/ambrogio-app/ambrogio-model beside it and retry." >&2
  exit 1
fi
exec "$checks"
